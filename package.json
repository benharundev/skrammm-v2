  "devDependencies": {
    "@playwright/test": "1.52.0",
    "@types/node": "22.15.21",
    "@types/qrcode": "1.5.5",
    "@types/react": "19.1.6",
    "@types/react-dom": "19.1.5",
    "@types/uuid": "10.0.0",
    "@typescript-eslint/eslint-plugin": "8.33.0",
    "@typescript-eslint/parser": "8.33.0",
    "@vitejs/plugin-react": "4.5.1",
    "@vitest/coverage-v8": "3.2.1",
    "eslint": "9.28.0",
    "eslint-plugin-import": "2.31.0",
