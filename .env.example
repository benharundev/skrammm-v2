# ============================================================
# Skrammm — Environment Variables
# Copy to .env.local for local development
# Production secrets are managed in /opt/skrammm/.env on the VPS
# NEVER commit a .env file with real secrets
# ============================================================

# ------------------------------------------------------------
# Database
# LOCAL ONLY — on the VPS, docker-compose.yml constructs and
# injects DATABASE_URL directly: postgresql://skram:${POSTGRES_PASSWORD}@postgres:5432/skram
# You do NOT put DATABASE_URL in the VPS .env
# ------------------------------------------------------------
DATABASE_URL=postgresql://skram:localpassword@localhost:5432/skram

# ------------------------------------------------------------
# Better Auth
# ------------------------------------------------------------
# → Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32
# → Production: https://app.skrammm.com
BETTER_AUTH_URL=http://app.localhost.skrammm.com:3000
# → BUILD-TIME ONLY — set as NEXT_PUBLIC_APP_URL env var in GitHub Actions
#   Not needed in the VPS .env (it is baked into the Next.js bundle at image build time)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------
# AWS — SES (email) + S3 (file storage)
# → AWS Console → IAM → Users → Create user
#     Attach policies: AmazonSESFullAccess + AmazonS3FullAccess
#     Security credentials tab → Create access key → Application running outside AWS
# NOTE: SES starts in sandbox — request production access BEFORE alpha launch
# ------------------------------------------------------------
AWS_REGION=ap-southeast-1
# → IAM user access key (see above)
AWS_ACCESS_KEY_ID=
# → IAM user secret key (see above)
AWS_SECRET_ACCESS_KEY=
# → AWS Console → SES → Verified Identities → verify skrammm.com domain
SES_FROM_ADDRESS=noreply@skrammm.com

# S3
# → AWS Console → S3 → Create bucket → copy the bucket name here
S3_BUCKET_ASSETS=skram-assets
S3_BUCKET_BACKUPS=skram-backups
# → Cloudflare dashboard → custom domain pointing to the S3 assets bucket
CLOUDFLARE_CDN_URL=https://assets.skrammm.com

# ------------------------------------------------------------
# QR Tokens
# → Generate: openssl rand -base64 32
# ------------------------------------------------------------
QR_HMAC_SECRET=

# ------------------------------------------------------------
# Observability
# ------------------------------------------------------------
# → sentry.io → Create project → Settings → Client Keys → DSN
SENTRY_DSN=
# → app.axiom.co → Settings → API Tokens → New token (Ingest permission)
AXIOM_TOKEN=
# → app.axiom.co → Datasets → create a dataset named skrammm-logs
AXIOM_DATASET=skrammm-logs

# ------------------------------------------------------------
# Payments — Billplz (dormant for UAT + Alpha)
# Gate via PAYMENTS_ENABLED=false — leave Billplz keys empty until active
# → billplz.com → API → credentials
# ------------------------------------------------------------
PAYMENTS_ENABLED=false
BILLPLZ_API_KEY=
BILLPLZ_COLLECTION_ID=
BILLPLZ_SIGNATURE_KEY=

# ------------------------------------------------------------
# Redis
# LOCAL ONLY — on the VPS, docker-compose.yml injects REDIS_URL=redis://redis:6379
# You do NOT put REDIS_URL in the VPS .env
# (app falls through to DB if absent in local dev)
# ------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------
# Postgres password (used by docker-compose.yml for both the
# postgres container and to construct DATABASE_URL for nextjs)
# → Generate: openssl rand -base64 32
# ------------------------------------------------------------
POSTGRES_PASSWORD=localpassword

# ------------------------------------------------------------
# Docker image (VPS / docker-compose.yml only)
# → ghcr.io/sysemy-tech/skrammm:latest
#   CI sets this automatically on deploy. For a manual first deploy,
#   set it to the tag you want to run.
# ------------------------------------------------------------
IMAGE=

# ============================================================
# VPS /opt/skrammm/.env TEMPLATE
# Copy the block below (without the leading #) to the VPS.
# DATABASE_URL and REDIS_URL are omitted — docker-compose sets them.
# NEXT_PUBLIC_APP_URL is omitted — it is baked in at image build time.
# ============================================================
#
# IMAGE=ghcr.io/sysemy-tech/skrammm:latest
# POSTGRES_PASSWORD=<openssl rand -base64 32>
# BETTER_AUTH_SECRET=<openssl rand -base64 32>
# BETTER_AUTH_URL=https://app.skrammm.com
# AWS_REGION=ap-southeast-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# SES_FROM_ADDRESS=noreply@skrammm.com
# S3_BUCKET_ASSETS=skram-assets
# S3_BUCKET_BACKUPS=skram-backups
# CLOUDFLARE_CDN_URL=https://assets.skrammm.com
# QR_HMAC_SECRET=<openssl rand -base64 32>
# SENTRY_DSN=
# AXIOM_TOKEN=
# AXIOM_DATASET=skrammm-logs
# PAYMENTS_ENABLED=false
