# ============================================================
# Skrammm — Environment Variables
# Copy to .env.local for local development
# Production secrets live in GCP Secret Manager
# NEVER commit a .env file with real secrets
# ============================================================

# ------------------------------------------------------------
# Database
# ------------------------------------------------------------
DATABASE_URL=postgresql://skram:localpassword@localhost:5432/skram

# ------------------------------------------------------------
# Better Auth
# ------------------------------------------------------------
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://app.localhost.skrammm.com:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------
# AWS — SES only (transactional email: OTP, invitations, claim codes)
# On GCP Compute Engine, these must be explicit env vars (no IAM role for AWS).
# NOTE: SES starts in sandbox — production access REQUIRED BEFORE ALPHA
# ------------------------------------------------------------
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_FROM_ADDRESS=noreply@skrammm.com

# ------------------------------------------------------------
# GCP — Cloud Storage (file uploads: logos, photos, perf cards)
# On Compute Engine, auth is automatic via the attached service account.
# For local dev, point to a service account key JSON:
#   GOOGLE_APPLICATION_CREDENTIALS=/path/to/sa-key.json
# ------------------------------------------------------------
GCS_BUCKET_ASSETS=skram-assets
GCS_BUCKET_BACKUPS=skram-backups
CLOUDFLARE_CDN_URL=https://assets.skrammm.com
GOOGLE_APPLICATION_CREDENTIALS=

# ------------------------------------------------------------
# QR Tokens
# ------------------------------------------------------------
# Generate with: openssl rand -base64 32
QR_HMAC_SECRET=

# ------------------------------------------------------------
# Observability
# ------------------------------------------------------------
SENTRY_DSN=
AXIOM_TOKEN=
AXIOM_DATASET=skrammm-logs

# ------------------------------------------------------------
# Payments — Billplz (dormant for UAT + Alpha)
# Gate via PAYMENTS_ENABLED=false
# ------------------------------------------------------------
PAYMENTS_ENABLED=false
BILLPLZ_API_KEY=
BILLPLZ_COLLECTION_ID=
BILLPLZ_SIGNATURE_KEY=

# ------------------------------------------------------------
# Redis (optional locally — app falls through to DB if absent)
# Provided automatically via docker-compose.local.yml REDIS_URL env
# ------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------
# Postgres password (used by docker-compose.yml)
# ------------------------------------------------------------
POSTGRES_PASSWORD=localpassword
